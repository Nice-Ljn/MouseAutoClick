<Window x:Class="MouseRecorderWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MouseRecorderWpf.ViewModels"
        Title="鼠标录制工具" Height="650" Width="980" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB"
        Icon="pack://application:,,,/Icons/app.ico">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo & 标题 -->
                <Border Padding="24,28,24,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#3B82F6">
                            <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="鼠标录制工具"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="#111827"/>
                            <TextBlock Text="自动化助手"
                                     FontSize="11"
                                     Foreground="#9CA3AF"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Row="1" Height="1" Background="#F3F4F6" Margin="24,0"/>

                <!-- 导航按钮 -->
                <StackPanel Grid.Row="2" Margin="0,16,0,16">
                    <TextBlock Text="功能"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="#9CA3AF"
                             Margin="24,8,24,8"/>

                    <Button x:Name="BtnRecorder"
                            Content="🎬  鼠标录制器"
                            Style="{StaticResource SidebarActiveButton}"
                            Click="BtnRecorder_Click"/>

                    <Button x:Name="BtnMultiClick"
                            Content="🎯  多目标连点器"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnMultiClick_Click"/>

                    <Button x:Name="BtnMixedAction"
                            Content="⌨️  键鼠混合录制"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnMixedAction_Click"/>
                </StackPanel>

                <!-- 底部信息 -->
                <Border Grid.Row="3" Padding="24,16" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="运行中"
                                 FontSize="12"
                                 Foreground="#6B7280"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentView}" Margin="24,20"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>