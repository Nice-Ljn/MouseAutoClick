<UserControl x:Class="MouseRecorderWpf.Views.MixedActionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MouseRecorderWpf.ViewModels"
             xmlns:models="clr-namespace:MouseRecorderWpf.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:MixedActionViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#EFF6FF" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="方案管理" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="PlanComboBox" Width="160"
                                  ItemsSource="{Binding PlanNames}"
                                  SelectedItem="{Binding CurrentPlanName, Mode=TwoWay}"
                                  SelectionChanged="PlanComboBox_SelectionChanged"
                                  VerticalAlignment="Center"/>
                        <Button Content="添加" Margin="10,0,0,0" Click="BtnAddPlan_Click" Style="{StaticResource SmallPrimaryButton}"/>
                        <Button Content="删除" Margin="6,0,0,0" Click="BtnDeletePlan_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="Tag" Value="#FEE2E2"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="1" Height="20" Background="#E5E7EB" Margin="12,0,10,0" VerticalAlignment="Center"/>
                        <Button Content="重命名" Click="BtnRenamePlan_Click" Style="{StaticResource SmallButton}"/>
                        <Button Content="导出" Margin="6,0,0,0" Click="BtnExportPlan_Click" Style="{StaticResource SmallButton}"/>
                        <Button Content="导入" Margin="6,0,0,0" Click="BtnImportPlan_Click" Style="{StaticResource SmallButton}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前位置:" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="#EFF6FF" CornerRadius="5" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPosition}"
                                       Foreground="#3B82F6"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="F4 添加鼠标左键"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="状态:" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="#ECFDF5" CornerRadius="5" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#10B981"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="F7 录制键鼠"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#FFF7ED" VerticalAlignment="Center">
                        <TextBlock Text="📝" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="操作列表" FontWeight="SemiBold" FontSize="14" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="ActionGrid" Grid.Column="0"
                              ItemsSource="{Binding Actions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectedItem="{Binding SelectedAction}"
                              SelectedIndex="{Binding SelectedIndex}"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="60"/>
                            <DataGridComboBoxColumn Header="操作类型" Width="85"
                                                    SelectedItemBinding="{Binding ActionTypeName}">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="system:String" xmlns:system="clr-namespace:System;assembly=mscorlib">
                                        <system:String>鼠标左键</system:String>
                                        <system:String>鼠标右键</system:String>
                                        <system:String>鼠标双击</system:String>
                                        <system:String>鼠标中键</system:String>
                                        <system:String>键盘按下</system:String>
                                        <system:String>键盘释放</system:String>
                                        <system:String>键盘按键</system:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="X" Binding="{Binding Position.X}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Y" Binding="{Binding Position.Y}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="按键" Binding="{Binding KeyName}" Width="75"/>
                            <DataGridTextColumn Header="延迟(ms)" Binding="{Binding Delay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Button Content="上移" Margin="0,0,0,5" Width="72" Click="BtnUp_Click" Style="{StaticResource DefaultButton}"/>
                        <Button Content="下移" Margin="0,0,0,5" Width="72" Click="BtnDown_Click" Style="{StaticResource DefaultButton}"/>
                        <Button Content="删除" Margin="0,0,0,5" Width="72" Click="BtnRemove_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}">
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                    <Setter Property="Foreground" Value="#D97706"/>
                                    <Setter Property="Tag" Value="#FEF3C7"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="清空" Width="72" Click="BtnClear_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="Tag" Value="#FEE2E2"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16,16,20,16" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="循环次数" FontWeight="Medium" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="循环间隙(ms)" FontWeight="Medium" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,6"/>

                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                         Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Left"
                         MinHeight="32"
                         MinWidth="150"/>
                <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                         Text="{Binding LoopInterval, UpdateSourceTrigger=PropertyChanged}"
                         Margin="16,0,0,0"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Left"
                         MinHeight="32"
                         MinWidth="150"/>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Orientation="Horizontal"  VerticalAlignment="Bottom">
                    <Button Content="● 录制 (F7)" Click="BtnToggleRecording_Click" Height="32" MinHeight="32">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource WarningButton}">
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="▶ 开始 (F5)" Click="BtnStart_Click" Style="{StaticResource SuccessButton}" Height="32" MinHeight="32" Margin="6,0" Padding="12,0" VerticalContentAlignment="Center"/>
                    <Button Content="■ 停止 (F6)" Click="BtnStop_Click" Style="{StaticResource DangerButton}" Height="32" MinHeight="32" Margin="6,0,0,0" Padding="12,0" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
